# Copy these values to Netlify: Site configuration -> Environment variables.
# Never add real keys to this file or to the HTML.
AI_PROVIDER=cloudflare
# Optional hardening for production, comma-separated exact origins:
# AI_ALLOWED_ORIGINS=https://dapper-pastelito-d5f921.netlify.app

# Gemini Developer API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Cloudflare Workers AI
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_OCR_MODEL=@cf/moondream/moondream3.1-9B-A2B
CLOUDFLARE_ASSESS_MODEL=@cf/meta/llama-3.1-8b-instruct-fast
# Set only after the account owner explicitly accepts the Meta Llama 3.2 license and AUP.
CLOUDFLARE_LLAMA32_AGREED=false
